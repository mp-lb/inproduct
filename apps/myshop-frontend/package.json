    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "superjson": "2.2.6"
  },
  "devDependencies": {
    "@mp-lb/inproduct-myshop-backend": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trpc/server": "11.7.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vite": "^7.3.3"
  }
}
