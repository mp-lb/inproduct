{
  "name": "@mp-lb/inproduct-myshop-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:local": "pnpm --filter @mp-lb/inproduct --filter @mp-lb/inproduct-storage --filter @mp-lb/inproduct-data-jobs build && tsc --noEmit && vite build",
