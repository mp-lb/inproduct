{
  "name": "@mp-lb/inproduct-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port ${DOCS_PORT:?Run through Zap to allocate DOCS_PORT}",
    "build": "react-router build && tsx scripts/prepareDocsPreview.ts && tsx scripts/checkDocs.ts",
    "typecheck": "react-router typegen && tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "start": "serve ./build/client --config ../../serve.json -l tcp://127.0.0.1:${DOCS_PORT:?Run through Zap to allocate DOCS_PORT}"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "cn": "0.4.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "serve": "14.2.6"
  },
  "version": "0.0.1"
}
