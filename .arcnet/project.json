{
  "version": 1,
  "mode": "vercel",
  "slug": "inproduct",
  "repository": "mp-lb/inproduct",
  "approved": true,
  "account": {
    "type": "team",
    "id": "team_1w5PsP1pNWCex9vAwF4PqvTs"
  },
  "sites": {
    "docs": {
      "mode": "existing",
      "projectName": "inproduct-docs",
      "build": [
        "pnpm",
        "--filter",
        "@mp-lb/inproduct-docs",
        "build"
      ],
      "output": "apps/docs/build/client",
      "outputConfig": {
        "version": 3,
        "routes": [
          {
            "src": "/api/search",
            "headers": {
              "Content-Type": "application/json; charset=utf-8"
            },
            "continue": true
          },
          {
            "handle": "filesystem"
          },
          {
            "src": "/(.+?)/?",
            "dest": "/$1/index.html",
            "check": true
          },
          {
            "src": "/(.*)",
            "dest": "/404.html",
            "status": 404
          }
        ]
      },
      "projectId": "prj_LQy5bWkXPbzDurQBAqQ6XB1Kx1Oq"
    }
  }
}
