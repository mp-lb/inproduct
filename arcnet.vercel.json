{
  "repository": "mp-lb/inproduct",
  "account": {
    "type": "team",
    "id": "team_1w5PsP1pNWCex9vAwF4PqvTs"
  },
  "sites": {
    "frontend": {
      "mode": "existing",
      "projectId": "prj_BZ7htFNVvwtaUiJSgVSc2RIWEe49",
      "projectName": "inproduct",
      "build": [
        "pnpm",
        "--filter",
        "@mp-lb/inproduct-frontend",
        "build"
      ],
      "output": "apps/frontend/dist",
      "outputConfig": {
        "version": 3,
        "routes": [
          {
            "src": "/(.+)/",
            "headers": {
              "Location": "/$1"
            },
            "status": 308
          },
          {
            "src": "/(.+)\\.html",
            "headers": {
              "Location": "/$1"
            },
            "status": 308
          },
          {
            "handle": "filesystem"
          },
          {
            "src": "/(.*)",
            "dest": "/index.html"
          }
        ]
      }
    },
    "docs": {
      "mode": "new",
      "projectName": "inproduct-docs",
      "creationApproved": false,
      "build": [
        "pnpm",
        "--filter",
        "@mp-lb/inproduct-docs",
        "build"
      ],
      "output": "apps/docs/build/client",
      "outputConfig": {
        "version": 3,
        "routes": [
          {
            "src": "/api/search",
            "headers": {
              "Content-Type": "application/json; charset=utf-8"
            },
            "continue": true
          },
          {
            "handle": "filesystem"
          },
          {
            "src": "/(.+?)/?",
            "dest": "/$1/index.html",
            "check": true
          },
          {
            "src": "/(.*)",
            "dest": "/404.html",
            "status": 404
          }
        ]
      }
    }
  }
}
