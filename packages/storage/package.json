{
  "name": "@mp-lb/inproduct-storage",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./trpc": {
      "types": "./dist/trpc.d.ts",
      "import": "./dist/trpc.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./file-library": {
      "types": "./dist/fileLibrary.d.ts",
      "import": "./dist/fileLibrary.js"
    },
    "./file-library/server": {
      "types": "./dist/fileLibraryServer.d.ts",
      "import": "./dist/fileLibraryServer.js"
    },
    "./file-library/testing": {
      "types": "./dist/fileLibraryTesting.d.ts",
      "import": "./dist/fileLibraryTesting.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/tests/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-lb/inproduct.git",
    "directory": "packages/storage"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "Composable object storage for InProduct applications.",
  "peerDependencies": {
    "mongodb": "^7.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "jsdom": "^30.0.1",
    "mongodb": "7.2.0",
    "react": "^19.2.8"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
