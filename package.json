{
  "name": "@mp-lb/inproduct-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "python3 scripts/run_validation.py -- pnpm -r --workspace-concurrency=1 --if-present build",
    "changeset": "changeset",
    "dev": "pnpm --filter @mp-lb/inproduct-backend dev",
    "lint": "python3 scripts/run_validation.py --profile lint -- eslint .",
    "release": "changeset publish",
    "typecheck": "python3 scripts/run_validation.py -- pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "version-packages": "changeset version",
    "test": "python3 scripts/run_validation.py -- pnpm -r --workspace-concurrency=1 --if-present test"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@mp-lb/fssstack-config": "0.3.1",
    "@mp-lb/fssstack-testing": "0.1.0",
    "@types/node": "20.19.39",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "description": "A collection of tools to put in your product."
}
