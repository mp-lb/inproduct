{
  "name": "@mp-lb/inproduct-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "python3 scripts/run_validation.py -- pnpm -r --workspace-concurrency=1 --if-present build",
    "changeset": "changeset",
    "dev": "zap task myshop",
    "lint": "python3 scripts/run_validation.py --profile lint -- eslint .",
    "release": "changeset publish",
    "typecheck": "python3 scripts/run_validation.py -- pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "version-packages": "changeset version",
    "test": "pnpm secrets:test && python3 scripts/run_validation.py -- pnpm -r --workspace-concurrency=1 --if-present test",
    "docs:gen": "python3 scripts/run_validation.py -- pnpm --filter @mp-lb/inproduct-docs build",
    "docs:check": "pnpm docs:gen",
    "secrets:test": "node --test scripts/secrets/*.test.mjs",
    "secrets:sync": "node scripts/secrets/sync.mjs",
    "docs:test": "python3 scripts/run_validation.py -- pnpm exec playwright test --config tests/docs/playwright.config.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@mp-lb/forum-secrets": "0.2.1",
    "@mp-lb/fssstack-config": "0.3.1",
    "@mp-lb/fssstack-testing": "0.1.0",
    "@playwright/test": "1.64.0",
    "@types/node": "20.19.39",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "description": "A collection of tools to put in your product."
}
