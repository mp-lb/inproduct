{
  "name": "@mp-lb/inproduct-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsx packages/scripts/runValidation.ts -- pnpm -r --workspace-concurrency=1 --if-present build",
    "dev": "zap task myshop",
    "lint": "tsx packages/scripts/runValidation.ts --profile lint -- eslint . && monolith-mapper check",
    "modules:map": "monolith-mapper map --output module-map.json",
    "typecheck": "tsx packages/scripts/runValidation.ts -- pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "tsx packages/scripts/runValidation.ts -- pnpm -r --workspace-concurrency=1 --if-present test",
    "docs:gen": "tsx packages/scripts/runValidation.ts -- pnpm --filter @mp-lb/inproduct-docs build",
    "docs:check": "pnpm docs:gen",
    "secrets:sync": "arcnet secrets sync",
    "docs:test": "tsx packages/scripts/runValidation.ts -- pnpm exec playwright test --config tests/docs/playwright.config.ts",
    "secrets:check": "arcnet env check"
  },
  "devDependencies": {
    "@mp-lb/arcnet": "0.7.11",
    "@mp-lb/fssstack-config": "0.3.1",
    "@mp-lb/fssstack-testing": "0.1.0",
    "@mp-lb/monolith-mapper": "0.1.2",
    "@playwright/test": "1.64.0",
    "@types/node": "20.19.39",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "description": "A collection of tools to put in your product."
}
